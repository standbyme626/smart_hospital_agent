APP_NAME=smart-hospital-agent
APP_VERSION=3.1.0
ENV=dev
DEBUG=false

# Security
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production
JWT_TTL_MINUTES=720
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
PATIENT_USER=patient
PATIENT_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
RATE_LIMIT_PER_MINUTE=60

# Data
DATABASE_URL=postgresql://sha:change-me@127.0.0.1:5434/sha
REDIS_URL=redis://127.0.0.1:6381/0

# LLM: opencode-go
OPENCODE_API_BASE=https://opencode.ai/inference/go/openai/v1
OPENCODE_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=

# Embedding + rerank: SiliconFlow
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# Local fallback: WinPC Ollama (OpenAI-compatible)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3-0.6b-dpo-v11_2
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=20

# Retrieval
SEED_LIMIT=2000
RETRIEVAL_TOP_K=5
RETRIEVAL_DENSE_K=30
RETRIEVAL_SPARSE_K=30
RERANK_TOP_N=20

# Hospital MCP
HOSPITAL_MCP_URL=http://127.0.0.1:9100/mcp
HOSPITAL_MCP_TOKEN=
HITL_CONFIRM_TOKEN=change-me
MAX_UPLOAD_MB=8

# Cost accounting (USD per 1M tokens)
LLM_INPUT_COST_PER_M=0.15
LLM_OUTPUT_COST_PER_M=0.6
